{
  "name": "node-monorepo-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @williamthorsen/nmr and related packages",
  "keywords": [
    "monorepo",
    "pnpm",
    "release-automation",
    "script-runner",
    "workspace"
  ],
  "homepage": "https://github.com/williamthorsen/node-monorepo-tools#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/node-monorepo-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/node-monorepo-tools.git"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm --filter @williamthorsen/nmr-core run prepare && pnpm --filter @williamthorsen/nmr run prepare",
    "postinstall": "codeassembly sync --warn-only",
    "prepare": "lefthook check-install || lefthook install"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.72.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@williamthorsen/eslint-config-typescript": "20.1.3",
    "@williamthorsen/nmr": "workspace:*",
    "@williamthorsen/release-kit": "workspace:*",
    "@williamthorsen/strict-lint": "14.2.1",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.filesystem": "catalog:",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "@williamthorsen/tsconfig": "0.12.1",
    "codeassembly": "0.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "lefthook": "2.2.1",
    "prettier": "catalog:",
    "readyup": "catalog:",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "v11y-check": "workspace:*",
    "vite": "8.3.5",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.16.0"
  }
}
