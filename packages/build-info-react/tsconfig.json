{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // The components render DOM elements, which the root's Node-only `lib` does not declare.
    "lib": ["ES2025", "ESNext.Disposable", "DOM", "DOM.Iterable"],
  },
  "include": [
    "src/", //
    "*.ts",
  ],
}
