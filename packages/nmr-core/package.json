{
  "name": "@williamthorsen/nmr-core",
  "version": "0.15.1",
  "private": false,
  "description": "Shared utilities for node-monorepo-tools packages",
  "keywords": [
    "monorepo",
    "pnpm",
    "utilities"
  ],
  "homepage": "https://github.com/williamthorsen/node-monorepo-tools/tree/main/packages/nmr-core#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/node-monorepo-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/node-monorepo-tools.git",
    "directory": "packages/nmr-core"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "nmr-source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./cli": {
      "nmr-source": "./src/cli.ts",
      "types": "./dist/esm/cli.d.ts",
      "default": "./dist/esm/cli.js"
    },
    "./workspace": {
      "nmr-source": "./src/workspace.ts",
      "types": "./dist/esm/workspace.d.ts",
      "default": "./dist/esm/workspace.js"
    }
  },
  "files": [
    ".meta/changelog.json",
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "prepare": "node --conditions nmr-source ../nmr/src/cli-build.ts",
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.cli": "catalog:",
    "@williamthorsen/toolbelt.datetime": "catalog:",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.filesystem": "catalog:",
    "@williamthorsen/toolbelt.packaging": "catalog:",
    "@williamthorsen/toolbelt.terminal": "catalog:",
    "diff": "9.0.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
