{
  "name": "@williamthorsen/nmr",
  "version": "0.34.0",
  "private": false,
  "description": "Context-aware script runner for pnpm monorepos",
  "keywords": [
    "monorepo",
    "pnpm",
    "script-runner",
    "workspace"
  ],
  "homepage": "https://github.com/williamthorsen/node-monorepo-tools/tree/main/packages/nmr#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/node-monorepo-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/node-monorepo-tools.git",
    "directory": "packages/nmr"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": [
    "./dist/esm/cli*.js",
    "./dist/esm/vitest-git-isolation.js"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/esm/defineConfig.d.ts",
      "default": "./dist/esm/defineConfig.js"
    },
    "./prettier": {
      "types": "./dist/esm/prettier.d.ts",
      "default": "./dist/esm/prettier.js"
    },
    "./scripts": {
      "types": "./dist/esm/scripts.d.ts",
      "default": "./dist/esm/scripts.js"
    },
    "./taze": {
      "types": "./dist/esm/taze.d.ts",
      "default": "./dist/esm/taze.js"
    },
    "./vitest": {
      "types": "./dist/esm/vitest.d.ts",
      "default": "./dist/esm/vitest.js"
    },
    "./workspace": {
      "types": "./dist/esm/workspace.d.ts",
      "default": "./dist/esm/workspace.js"
    }
  },
  "bin": {
    "ensure-prepublish-hooks": "bin/ensure-prepublish-hooks.js",
    "nmr": "bin/nmr.js",
    "nmr-clean": "bin/nmr-clean.js",
    "nmr-compile": "bin/nmr-compile.js",
    "nmr-fmt": "bin/nmr-fmt.js",
    "nmr-report-catalog": "bin/nmr-report-catalog.js",
    "nmr-report-overrides": "bin/nmr-report-overrides.js",
    "nmr-taze": "bin/nmr-taze.js"
  },
  "files": [
    ".readyup/kits/*.js",
    ".readyup/manifest.json",
    "agents",
    "bin",
    "dist"
  ],
  "scripts": {
    "build:post": "rdy compile",
    "build:pre": "rdy verify",
    "prepare": "node src/cli-build.ts",
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/nmr-core": "workspace:*",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "glob": "13.0.6",
    "prettier-plugin-sh": "0.19.0",
    "taze": "21.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@williamthorsen/toolbelt.filesystem": "catalog:",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "prettier": "3.9.6",
    "readyup": "catalog:",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "prettier": ">=3.9.5 <4",
    "typescript": ">=5.7.0 <7",
    "vite": ">=8.0.0 <9",
    "vitest": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "publishConfig": {
    "access": "public"
  },
  "codeassembly": {
    "content": "agents"
  }
}
