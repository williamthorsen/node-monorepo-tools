# git-cliff configuration
# Splits git history into tag ranges and filters it by path. Nothing here classifies a commit.
#
# `buildChangelogEntries.ts` invokes cliff only for `--context` JSON output, and
# `classifyChangelogCommit.ts` decides from the commit message whether a commit reaches a changelog
# and under which section header. Markdown rendering is handled in-process by
# `renderChangelogMarkdown.ts`, so no `[changelog]` block is needed.
#
# The single pass-through parser and `filter_commits = false` together put every commit in the range
# into the `--context` payload, `release:` and merge commits included. The `group` value that cliff
# assigns is never read; it exists because cliff requires a parser to emit one.

[git]
conventional_commits = false
filter_unconventional = false
split_commits = false
commit_preprocessors = []
commit_parsers = [{ message = ".*", group = "unclassified" }]
protect_breaking_commits = false
filter_commits = false
tag_pattern = "v[0-9].*"
skip_tags = ""
ignore_tags = ""
topo_order = false
sort_commits = "oldest"
