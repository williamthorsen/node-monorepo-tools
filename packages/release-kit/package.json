{
  "name": "@williamthorsen/release-kit",
  "version": "14.0.0",
  "description": "Version-bumping and changelog-generation toolkit for release workflows",
  "keywords": [
    "changelog",
    "monorepo",
    "release",
    "semver",
    "versioning"
  ],
  "homepage": "https://github.com/williamthorsen/node-monorepo-tools/tree/main/packages/release-kit#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/node-monorepo-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/node-monorepo-tools.git",
    "directory": "packages/release-kit"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": [
    "./dist/esm/bin/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./config": {
      "types": "./dist/esm/defineConfig.d.ts",
      "import": "./dist/esm/defineConfig.js"
    }
  },
  "bin": {
    "release-kit": "./bin/release-kit.js"
  },
  "files": [
    ".meta/changelog.json",
    ".readyup/kits/*.js",
    ".readyup/manifest.json",
    "CHANGELOG.md",
    "bin",
    "dist/*",
    "docs",
    "!docs/*.v*.md",
    "presets/**",
    "schemas/**"
  ],
  "scripts": {
    "build:post": "rdy compile",
    "build:pre": "rdy verify",
    "prepare": "node ../nmr/src/cli-build.ts",
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/change-grammar": "workspace:*",
    "@williamthorsen/nmr-core": "workspace:*",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "json-stringify-pretty-compact": "4.0.0",
    "semver": "7.8.5",
    "yaml": "catalog:",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "@williamthorsen/toolbelt.filesystem": "catalog:",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "actionlint": "2.0.6",
    "esbuild": "catalog:",
    "readyup": "catalog:",
    "smol-toml": "1.9.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
