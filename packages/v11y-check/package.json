{
  "name": "v11y-check",
  "version": "0.15.1",
  "private": false,
  "description": "Wrap audit-ci with a richer config model, typed JSON source of truth, and sync workflow",
  "keywords": [
    "audit",
    "audit-ci",
    "dependencies",
    "security",
    "vulnerabilities"
  ],
  "homepage": "https://github.com/williamthorsen/node-monorepo-tools/tree/main/packages/v11y-check#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/node-monorepo-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/node-monorepo-tools.git",
    "directory": "packages/v11y-check"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "bin": {
    "v11y": "bin/v11y.js",
    "v11y-check": "bin/v11y.js"
  },
  "files": [
    ".readyup/kits/*.js",
    ".readyup/manifest.json",
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build:post": "rdy compile",
    "build:pre": "rdy verify",
    "prepare": "node ../nmr/src/cli-build.ts",
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/nmr-core": "workspace:*",
    "audit-ci": "7.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "readyup": "0.26.0"
  },
  "engines": {
    "node": ">=24"
  }
