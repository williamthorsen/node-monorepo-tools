// TSConfig for the monorepo root. The compiler baseline comes from `@williamthorsen/tsconfig`;
// only the keys that base leaves to its consumer are set here.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@williamthorsen/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@williamthorsen/nmr/config": ["./packages/nmr/src/defineConfig.ts"],
      "@williamthorsen/nmr/scripts": ["./packages/nmr/src/scripts.ts"],
      "@williamthorsen/nmr/taze": ["./packages/nmr/src/taze.ts"],
      "@williamthorsen/nmr/vitest": ["./packages/nmr/src/vitest.ts"],
      "@williamthorsen/nmr/workspace": ["./packages/nmr/src/workspace.ts"],
      "@williamthorsen/release-kit/config": ["./packages/release-kit/src/defineConfig.ts"],
      "~/*": ["./*"],
    },
    // The base leaves ambient types to the consumer, defaulting to none.
    "types": ["node"],
  },
  "exclude": ["node_modules"],
  "include": [
    // This file covers only the monorepo root. Packages have their own tsconfig.json files that extend this one.
    ".config/**/*.ts",
    ".readyup/**/*.ts",
    "__tests__/",
    "config/",
    "scripts/",
    // Root-level config files (vite/vitest); the project service resolves each linted `.ts` file's owning config here.
    "*.ts",
  ],
}
